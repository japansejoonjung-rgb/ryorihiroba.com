rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isAdmin() {
      return signedIn() &&
        exists(userDoc(request.auth.uid)) &&
        get(userDoc(request.auth.uid)).data.role == 'admin';
    }

    function ownsIncomingUserId() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function ownsExistingUserId() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'user' &&
        request.resource.data.status == 'active';
      allow update: if isAdmin() || (
        signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'recoveryQuestion',
          'recoveryAnswerHash',
          'updatedAt'
        ])
      );
      allow delete: if isAdmin();
    }

    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() || (
        signedIn() &&
        resource.data.authorId == request.auth.uid &&
        request.resource.data.authorId == resource.data.authorId
      ) || (
        signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'saves', 'views', 'updatedAt'])
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
    }

    match /recipeLikes/{likeId} {
      allow read: if true;
      allow create: if ownsIncomingUserId();
      allow delete: if ownsExistingUserId() || isAdmin();
    }

    match /favorites/{favoriteId} {
      allow read: if ownsExistingUserId() || isAdmin();
      allow create: if ownsIncomingUserId();
      allow delete: if ownsExistingUserId() || isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if ownsIncomingUserId();
      allow delete: if ownsExistingUserId() || isAdmin();
    }

    match /pointTransactions/{transactionId} {
      allow read: if ownsExistingUserId() || isAdmin();
      allow create: if signedIn() &&
        request.resource.data.amount is int &&
        request.resource.data.amount > 0 &&
        request.resource.data.keys().hasOnly(['userId', 'amount', 'type', 'sourceId', 'description', 'createdAt']) &&
        (
          (
            request.resource.data.type in ['signup', 'recipe_post'] &&
            request.resource.data.userId == request.auth.uid
          ) ||
          request.resource.data.type == 'like_received' ||
          isAdmin()
        );
      allow update, delete: if isAdmin();
    }
  }
}
